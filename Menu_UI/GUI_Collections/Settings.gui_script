local druid = require("druid.druid")

local function send_change_scene(self,params,button)
	pprint("Next Scene sent to Scene Loader")
	msg.post("Scene_Loader:/Game_Loader#Scene_Loader",params)
	--This is going to be sending the signal to scene_loader what to load next in the scene
end

function init(self)
	msg.post(".", "acquire_input_focus")
	
	self.druid = druid.new(self)

	self.Back_To_Menu= self.druid:new_button("Back/Root",send_change_scene,"Exit_Settings")

	self.mute= self.druid:new_button("Mute",function() 
		sound.set_gain("Scene_Loader:/Music", 0.0)
		pprint("Mute")
	end)
	self.sound_25= self.druid:new_button("25_Vol",function()	
		sound.set_gain("Scene_Loader:/Music", 0.25)
		pprint("25%")
	end)
	self.sound_50= self.druid:new_button("50_Vol",function() 
		sound.set_gain("Scene_Loader:/Music", 0.50)
		pprint("50%")
	end)
	self.sound_75= self.druid:new_button("75_Vol",function()	
		sound.set_gain("Scene_Loader:/Music", 0.75)
		pprint("75%")
	end)
	self.sound_100= self.druid:new_button("100_Vol",function() 
		sound.set_gain("Scene_Loader:/Music", 1.0)
		pprint("100%")
	end)
	
end

function on_input(self, action_id, action)
	print(action_id, action.pressed)
	return self.druid:on_input(action_id, action)
end

function final(self)
	self.druid:final()
end

function update(self, dt)
	self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end