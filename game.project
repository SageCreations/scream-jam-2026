[project]
title = Screaming Runner
dependencies#0 = https://github.com/Insality/defold-event/archive/refs/tags/21.zip
dependencies#1 = https://github.com/Insality/druid/archive/refs/tags/1.4.1.zip
dependencies#2 = https://github.com/britzl/monarch/archive/refs/tags/6.0.3.zip

[bootstrap]
main_collection = /Menu_UI/Menu_Testing.collectionc

[input]
game_binding = /input/game.input_bindingc

[display]
width = 1280
height = 720
vsync = 0
update_frequency = 60

[physics]
scale = 0.02
use_fixed_timestep = 1

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear

[script]
shared_state = 1

[particle_fx]
max_count = 1024
max_particle_count = 2048

[library]
include_dirs = def-runner

